{
  "name": "ritmo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RITMO — Personal Life Operating System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ritmo/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:api": "npm run dev -w @ritmo/api",
    "dev:web": "npm run dev -w @ritmo/web",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "npm run db:migrate -w @ritmo/api",
    "db:deploy": "npm run db:deploy -w @ritmo/api",
    "db:generate": "npm run db:generate -w @ritmo/api",
    "openapi": "npm run openapi -w @ritmo/api",
    "setup": "npm install && node -e \"const fs=require('fs');if(!fs.existsSync('apps/api/.env'))fs.copyFileSync('apps/api/.env.example','apps/api/.env')\" && npm run db:start && npm run db:generate && npm run db:deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
