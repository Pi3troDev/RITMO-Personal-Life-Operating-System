// RITMO — Personal Life Operating System
// Database schema DRAFT (planning phase — not yet applied to any database).
//
// Target: Prisma ORM 7.x on MariaDB (provider "mysql").
// Final location: apps/api/prisma/schema.prisma (the generator `output` below is relative to it).
// In Prisma 7 the connection URL is NOT declared here: it lives in apps/api/prisma.config.ts
// (`datasource.url`) and the client is instantiated with the @prisma/adapter-mariadb driver adapter.
//
// Conventions (details and rationale in docs/DATABASE.md):
// - Every user-owned row carries `userId` with ON DELETE CASCADE from `users`.
// - Between user-owned tables only CASCADE or SET NULL are used (never RESTRICT), so that
//   deleting a user can never be blocked by the order in which InnoDB walks the cascades.
// - IDs are UUID v7 stored as CHAR(36) (time-ordered, generated by Prisma Client).
// - Money: integer minor units (centavos) in `*Cents` columns + `currency` (ISO 4217).
// - Instants: UTC `DateTime`. Calendar days: `DateTime @db.Date`. Time of day: minutes from
//   midnight in the user's timezone (`*Minutes` Int columns).
// - Recurrence: RFC 5545 RRULE strings, expanded at read time.
// - Sortable lists use a fractional `position Float`.
// - Tables are mapped to lower snake_case so the schema behaves the same on Windows and Linux.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

/// Modules the user can enable/disable. Dashboard and Quick Capture are always on.
enum ModuleKey {
  AGENDA
  TASKS
  GOALS
  HABITS
  FINANCE
  STUDY
  DEV
  ENGLISH
  HEALTH
  SPIRITUAL
  READING
  REVIEWS
  INSIGHTS
}

/// Stable key of a seeded Area, so modules can find "the English area" even after a rename.
enum AreaKey {
  WORK
  STUDY
  PROGRAMMING
  ENGLISH
  FITNESS
  SPIRITUAL
  READING
  PERSONAL
  OTHER
}

enum TimeEntryKind {
  TASK
  STUDY
  DEV
  ENGLISH
  WORKOUT
  READING
  SPIRITUAL
  OTHER
}

enum TimerState {
  RUNNING
  PAUSED
  STOPPED
}

enum TimeEntrySource {
  TIMER
  MANUAL
}

enum EnglishSkill {
  LISTENING
  READING
  SPEAKING
  WRITING
}

enum GoalDimension {
  FINANCIAL
  PROFESSIONAL
  ACADEMIC
  INTELLECTUAL
  HEALTH
  SPIRITUAL
  PERSONAL
  RELATIONSHIPS
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum GoalProgressStrategy {
  MANUAL
  MILESTONES
  METRIC
}

enum GoalMetricType {
  /// Balance of the linked reserve account (centavos).
  MONEY_ACCUMULATED
  /// Sum of TimeEntry.durationSeconds linked to the goal (stored target in minutes).
  TIME_ACCUMULATED
  /// Count of DONE check-ins of the habits linked to the goal.
  HABIT_CHECKINS
}

enum ProgressSource {
  MANUAL
  AUTO
}

enum VisionStatus {
  OPEN
  ACHIEVED
  DROPPED
}

enum ProjectKind {
  GENERAL
  DEV
}

enum ProjectStatus {
  IDEA
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// A task's status is the category of the board column it sits in.
enum TaskStatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventKind {
  /// Fixed commitment, usually involving other people or places.
  APPOINTMENT
  /// Time the user reserves for their own work (study session, workout, deep work).
  TIME_BLOCK
}

enum EventOccurrenceStatus {
  /// Still pending, but this occurrence was moved/edited away from the series.
  SCHEDULED
  ATTENDED
  MISSED
  CANCELLED
}

enum CaptureKind {
  UNSORTED
  TASK
  IDEA
  EVENT
  EXPENSE
  NOTE
  GOAL
}

enum InboxStatus {
  PENDING
  CONVERTED
  DISCARDED
}

enum HabitTargetKind {
  CHECK
  DURATION
  QUANTITY
}

enum HabitScheduleKind {
  /// Specific days, described by an RRULE (e.g. FREQ=WEEKLY;BYDAY=MO,WE,FR).
  FIXED_DAYS
  /// "N times per week/month", any day.
  FLEXIBLE
}

/// There is deliberately no MISSED value: a missed day is the absence of a row.
enum HabitCheckInStatus {
  DONE
  /// Exceptional day (sick, travelling…): not expected, does not break consistency.
  EXCUSED
}

enum TargetPeriod {
  WEEK
  MONTH
}

enum AccountType {
  CHECKING
  CASH
  SAVINGS
  INVESTMENT
  OTHER
}

enum FinanceCategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  RESERVE_CONTRIBUTION
  RESERVE_WITHDRAWAL
}

enum StudyTrackKind {
  TRACK
  COURSE
}

enum StudyTrackStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
}

/// Shared by lessons and roadmap nodes: não iniciado / estudando / concluído.
enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum ResourceType {
  LINK
  VIDEO
  ARTICLE
  DOCUMENTATION
  BOOK
  FILE
  OTHER
}

/// What a PeriodicTarget counts. Each value maps to one deterministic query.
enum TargetMetric {
  TIME_MINUTES
  WORKOUT_SESSIONS
  PAGES_READ
  BIBLE_CHAPTERS
  VOCABULARY_ITEMS
}

enum ChallengeStatus {
  TODO
  IN_PROGRESS
  SOLVED
  ABANDONED
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum VocabularyKind {
  WORD
  PHRASE
}

enum VocabularyStatus {
  NEW
  LEARNING
  MASTERED
}

enum WorkoutType {
  STRENGTH
  WALK
  CARDIO
  OTHER
}

enum PrayerRequestStatus {
  ACTIVE
  ANSWERED
  ARCHIVED
}

enum BookStatus {
  WANT_TO_READ
  READING
  FINISHED
  PAUSED
}

enum ReviewType {
  WEEKLY
  MONTHLY
}

enum ReviewStatus {
  DRAFT
  COMPLETED
}

enum NotificationType {
  EVENT_REMINDER
  TASK_REMINDER
  HABIT_REMINDER
  TASK_DUE
  WEEKLY_REVIEW
  MONTHLY_REVIEW
  GOAL_DEADLINE
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. IDENTITY, SETTINGS AND MODULES
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid(7)) @db.Char(36)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @db.VarChar(255)
  name            String    @db.VarChar(120)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  settings                UserSettings?
  sessions                Session[]
  modules                 UserModule[]
  areas                   Area[]
  timeEntries             TimeEntry[]
  goals                   Goal[]
  milestones              Milestone[]
  goalProgressEntries     GoalProgressEntry[]
  visionItems             VisionItem[]
  projects                Project[]
  projectUpdates          ProjectUpdate[]
  boards                  Board[]
  boardColumns            BoardColumn[]
  tasks                   Task[]
  recurringTasks          RecurringTask[]
  checklistItems          ChecklistItem[]
  tags                    Tag[]
  taskTags                TaskTag[]
  events                  Event[]
  eventOccurrences        EventOccurrence[]
  reminders               Reminder[]
  dailyFocusItems         DailyFocusItem[]
  dailyReflections        DailyReflection[]
  inboxItems              InboxItem[]
  notes                   Note[]
  habits                  Habit[]
  habitSchedules          HabitSchedule[]
  habitCheckIns           HabitCheckIn[]
  habitPauses             HabitPause[]
  accounts                Account[]
  financeCategories       FinanceCategory[]
  transactions            Transaction[]
  budgets                 Budget[]
  plannedContributions    PlannedContribution[]
  netWorthSnapshots       NetWorthSnapshot[]
  studyTracks             StudyTrack[]
  studyModules            StudyModule[]
  lessons                 Lesson[]
  resources               Resource[]
  periodicTargets         PeriodicTarget[]
  technologies            Technology[]
  projectTechnologies     ProjectTechnology[]
  roadmaps                Roadmap[]
  roadmapNodes            RoadmapNode[]
  challenges              Challenge[]
  vocabularyItems         VocabularyItem[]
  exercises               Exercise[]
  workoutPlans            WorkoutPlan[]
  workoutPlanExercises    WorkoutPlanExercise[]
  workoutLogs             WorkoutLog[]
  workoutSets             WorkoutSet[]
  devotionals             Devotional[]
  bibleReadingLogs        BibleReadingLog[]
  prayerRequests          PrayerRequest[]
  prayerLogs              PrayerLog[]
  books                   Book[]
  readingLogs             ReadingLog[]
  bookQuotes              BookQuote[]
  reviews                 Review[]
  reviewAnswers           ReviewAnswer[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]

  @@map("users")
}

model UserSettings {
  userId               String   @id @db.Char(36)
  /// IANA timezone, e.g. "America/Sao_Paulo". Defines the user's calendar day.
  timezone             String   @default("America/Sao_Paulo") @db.VarChar(64)
  locale               String   @default("pt-BR") @db.VarChar(10)
  weekStartsOn         Weekday  @default(MONDAY)
  theme                Theme    @default(DARK)
  currency             String   @default("BRL") @db.Char(3)
  /// "Planejamento realista": planned minutes per day above which the UI warns. Null = no limit.
  dailyCapacityMinutes Int?
  defaultBoardId       String?  @unique @db.Char(36)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultBoard Board? @relation("DefaultBoard", fields: [defaultBoardId], references: [id], onDelete: SetNull)

  @@map("user_settings")
}

/// One row per issued refresh token. Rotation creates a new row in the same family.
model Session {
  id         String    @id @default(uuid(7)) @db.Char(36)
  userId     String    @db.Char(36)
  /// Shared by all tokens descending from one login; reuse of a revoked token revokes the family.
  familyId   String    @db.Char(36)
  /// SHA-256 (hex) of the refresh token. The token itself is never stored.
  tokenHash  String    @unique @db.Char(64)
  userAgent  String?   @db.VarChar(255)
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Per-user module switch and sidebar order. A missing row means "enabled, default order".
model UserModule {
  userId    String    @db.Char(36)
  module    ModuleKey
  enabled   Boolean   @default(true)
  position  Float     @default(0)
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@map("user_modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. INTEGRATION BACKBONE — areas, time ledger, goals
// ─────────────────────────────────────────────────────────────────────────────

/// Life area / category shared by tasks, events, habits, goals, projects and time entries.
model Area {
  id         String    @id @default(uuid(7)) @db.Char(36)
  userId     String    @db.Char(36)
  name       String    @db.VarChar(60)
  /// Set only on seeded areas; lets a module find its area after the user renames it.
  systemKey  AreaKey?
  /// Design-system token name (never a raw hex colour).
  colorToken String    @db.VarChar(32)
  /// Lucide icon name.
  icon       String    @db.VarChar(48)
  position   Float     @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries     TimeEntry[]
  goals           Goal[]
  projects        Project[]
  tasks           Task[]
  recurringTasks  RecurringTask[]
  events          Event[]
  habits          Habit[]
  notes           Note[]
  studyTracks     StudyTrack[]
  roadmaps        Roadmap[]
  periodicTargets PeriodicTarget[]

  @@unique([userId, name])
  @@unique([userId, systemKey])
  @@index([userId, archivedAt, position])
  @@map("areas")
}

/// The single ledger of time actually spent. Every "session" in the product is a row here.
model TimeEntry {
  id              String          @id @default(uuid(7)) @db.Char(36)
  userId          String          @db.Char(36)
  kind            TimeEntryKind
  source          TimeEntrySource @default(TIMER)
  timerState      TimerState      @default(STOPPED)
  title           String?         @db.VarChar(200)
  notes           String?         @db.Text
  startedAt       DateTime
  /// Null while the timer is running or paused.
  endedAt         DateTime?
  /// Set while RUNNING; elapsed = durationSeconds + (now - lastResumedAt).
  lastResumedAt   DateTime?
  /// Active time only (pauses excluded). Authoritative once STOPPED.
  durationSeconds Int             @default(0)
  /// Calendar day of `startedAt` in the user's timezone, written by the service.
  localDate       DateTime        @db.Date
  /// Only for kind = ENGLISH.
  englishSkill    EnglishSkill?

  // What the time was spent on. All optional; context (area/goal/project) is copied from the
  // source item when the entry is created so that reports are a single GROUP BY.
  areaId       String? @db.Char(36)
  goalId       String? @db.Char(36)
  projectId    String? @db.Char(36)
  taskId       String? @db.Char(36)
  eventId      String? @db.Char(36)
  habitId      String? @db.Char(36)
  studyTrackId String? @db.Char(36)
  lessonId     String? @db.Char(36)
  bookId       String? @db.Char(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  habit      Habit?      @relation(fields: [habitId], references: [id], onDelete: SetNull)
  studyTrack StudyTrack? @relation(fields: [studyTrackId], references: [id], onDelete: SetNull)
  lesson     Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  book       Book?       @relation(fields: [bookId], references: [id], onDelete: SetNull)
  workoutLog WorkoutLog?
  readingLog ReadingLog?

  @@index([userId, localDate])
  @@index([userId, kind, localDate])
  @@index([userId, areaId, localDate])
  @@index([userId, goalId, localDate])
  @@index([userId, projectId, localDate])
  @@index([userId, studyTrackId, localDate])
  @@index([userId, taskId])
  @@index([userId, timerState])
  @@map("time_entries")
}

model Goal {
  id               String               @id @default(uuid(7)) @db.Char(36)
  userId           String               @db.Char(36)
  areaId           String?              @db.Char(36)
  title            String               @db.VarChar(200)
  description      String?              @db.Text
  dimension        GoalDimension
  status           GoalStatus           @default(ACTIVE)
  startDate        DateTime             @db.Date
  targetDate       DateTime?            @db.Date
  progressStrategy GoalProgressStrategy @default(MANUAL)
  /// Required when progressStrategy = METRIC.
  metricType       GoalMetricType?
  /// Metric value at the start (centavos, minutes or count, depending on metricType).
  metricStart      Int                  @default(0)
  metricTarget     Int?
  /// The reserve account that funds this goal (metricType = MONEY_ACCUMULATED). One goal per account.
  reserveAccountId String?              @unique @db.Char(36)
  /// 0–100. Derived cache with a single writer (recalculateGoalProgress), which also
  /// upserts today's GoalProgressEntry.
  progressPercent  Float                @default(0)
  /// Last time anything linked to the goal moved (task done, time logged, check-in, contribution…).
  lastActivityAt   DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  reserveAccount  Account?            @relation(fields: [reserveAccountId], references: [id], onDelete: SetNull)
  milestones      Milestone[]
  progressEntries GoalProgressEntry[]
  visionItems     VisionItem[]
  timeEntries     TimeEntry[]
  projects        Project[]
  tasks           Task[]
  recurringTasks  RecurringTask[]
  events          Event[]
  habits          Habit[]
  notes           Note[]
  studyTracks     StudyTrack[]
  roadmaps        Roadmap[]
  books           Book[]
  inboxItems      InboxItem[]
  notifications   Notification[]

  @@index([userId, status, targetDate])
  @@index([userId, dimension, status])
  @@index([userId, status, lastActivityAt])
  @@map("goals")
}

model Milestone {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  goalId      String    @db.Char(36)
  title       String    @db.VarChar(200)
  description String?   @db.Text
  targetDate  DateTime? @db.Date
  /// Relative weight when the goal's progress is derived from milestones.
  weight      Int       @default(1)
  position    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, goalId, position])
  @@map("milestones")
}

/// Progress history: at most one point per goal per day, so evolution can be charted.
model GoalProgressEntry {
  id              String         @id @default(uuid(7)) @db.Char(36)
  userId          String         @db.Char(36)
  goalId          String         @db.Char(36)
  date            DateTime       @db.Date
  progressPercent Float
  /// Raw metric value on that day (centavos, minutes or count) when the strategy is METRIC.
  metricValue     Int?
  source          ProgressSource @default(AUTO)
  note            String?        @db.VarChar(500)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([userId, date])
  @@map("goal_progress_entries")
}

/// "Visão 2027": the main results the user wants for a given year.
model VisionItem {
  id          String         @id @default(uuid(7)) @db.Char(36)
  userId      String         @db.Char(36)
  year        Int
  title       String         @db.VarChar(200)
  description String?        @db.Text
  dimension   GoalDimension?
  /// Optional goal that turns this vision into an executable plan.
  goalId      String?        @db.Char(36)
  status      VisionStatus   @default(OPEN)
  position    Float          @default(0)
  achievedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, year, position])
  @@map("vision_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. PROJECTS, TASKS AND KANBAN
// ─────────────────────────────────────────────────────────────────────────────

/// One table for "normal" and dev projects. A project idea is a Project with status IDEA.
model Project {
  id            String        @id @default(uuid(7)) @db.Char(36)
  userId        String        @db.Char(36)
  areaId        String?       @db.Char(36)
  goalId        String?       @db.Char(36)
  kind          ProjectKind   @default(GENERAL)
  name          String        @db.VarChar(160)
  description   String?       @db.Text
  status        ProjectStatus @default(ACTIVE)
  startDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  /// Dev projects only.
  repositoryUrl String?       @db.VarChar(2048)
  productionUrl String?       @db.VarChar(2048)
  /// Shown in the Dev Space portfolio.
  isPortfolio   Boolean       @default(false)
  completedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  area           Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal           Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  updates        ProjectUpdate[]
  technologies   ProjectTechnology[]
  boards         Board[]
  tasks          Task[]
  recurringTasks RecurringTask[]
  events         Event[]
  timeEntries    TimeEntry[]
  notes          Note[]
  resources      Resource[]
  inboxItems     InboxItem[]

  @@index([userId, kind, status])
  @@index([userId, archivedAt])
  @@map("projects")
}

/// "Histórico de atualizações" of a project.
model ProjectUpdate {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  projectId String   @db.Char(36)
  date      DateTime @db.Date
  title     String?  @db.VarChar(200)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId, date])
  @@map("project_updates")
}

model Board {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  /// Optional: a board dedicated to one project.
  projectId   String?   @db.Char(36)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  position    Float     @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  columns    BoardColumn[]
  defaultFor UserSettings? @relation("DefaultBoard")

  @@index([userId, archivedAt, position])
  @@map("boards")
}

model BoardColumn {
  id             String             @id @default(uuid(7)) @db.Char(36)
  userId         String             @db.Char(36)
  boardId        String             @db.Char(36)
  name           String             @db.VarChar(80)
  /// The status every task in this column has. Source of truth for task status.
  statusCategory TaskStatusCategory
  position       Float              @default(0)
  wipLimit       Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks          Task[]
  recurringTasks RecurringTask[]

  @@index([userId, boardId, position])
  @@index([userId, statusCategory])
  @@map("board_columns")
}

/// Flexible work. Always lives in exactly one board column; its status is that column's
/// statusCategory. Optionally planned for a day and/or time-boxed on the agenda.
model Task {
  id          String       @id @default(uuid(7)) @db.Char(36)
  userId      String       @db.Char(36)
  columnId    String       @db.Char(36)
  position    Float        @default(0)
  title       String       @db.VarChar(255)
  description String?      @db.Text
  /// "Observações".
  notes       String?      @db.Text
  priority    TaskPriority @default(NONE)

  areaId      String? @db.Char(36)
  goalId      String? @db.Char(36)
  milestoneId String? @db.Char(36)
  projectId   String? @db.Char(36)
  habitId     String? @db.Char(36)

  /// Deadline (calendar day).
  dueDate          DateTime? @db.Date
  /// The day the user intends to work on it ("Meu Dia").
  plannedDate      DateTime? @db.Date
  /// Agenda time block (UTC). When set, plannedDate is its local calendar day.
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  estimateMinutes  Int?

  /// Set for an occurrence of a recurring task.
  recurringTaskId String?   @db.Char(36)
  /// The occurrence's original date in the series (RFC 5545 RECURRENCE-ID).
  occurrenceDate  DateTime? @db.Date

  /// Set when the task enters a DONE column, cleared when it leaves. Single writer: moveTask().
  completedAt DateTime?
  /// Decided not to do it: neither pending nor done in any metric.
  cancelledAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  column         BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  area           Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal           Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone      Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  habit          Habit?           @relation(fields: [habitId], references: [id], onDelete: SetNull)
  recurringTask  RecurringTask?   @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)
  checklistItems ChecklistItem[]
  tags           TaskTag[]
  timeEntries    TimeEntry[]
  reminders      Reminder[]
  focusItems     DailyFocusItem[]
  inboxItems     InboxItem[]
  notifications  Notification[]

  @@unique([recurringTaskId, occurrenceDate])
  @@index([userId, columnId, position])
  @@index([userId, completedAt])
  @@index([userId, dueDate])
  @@index([userId, plannedDate])
  @@index([userId, scheduledStartAt])
  @@index([userId, projectId])
  @@index([userId, goalId])
  @@map("tasks")
}

/// Rule + template of a recurring task. Never shown as a task itself: occurrences are real
/// Task rows (the next pending one is always materialised; later ones are expanded at read time).
model RecurringTask {
  id                    String       @id @default(uuid(7)) @db.Char(36)
  userId                String       @db.Char(36)
  title                 String       @db.VarChar(255)
  description           String?      @db.Text
  priority              TaskPriority @default(NONE)
  estimateMinutes       Int?
  areaId                String?      @db.Char(36)
  goalId                String?      @db.Char(36)
  projectId             String?      @db.Char(36)
  habitId               String?      @db.Char(36)
  /// Column where new occurrences start. Null = first TODO column of the default board.
  columnId              String?      @db.Char(36)
  /// RFC 5545 RRULE, without DTSTART (e.g. "FREQ=WEEKLY;BYDAY=FR").
  rrule                 String       @db.VarChar(500)
  /// DTSTART of the series (calendar day).
  startDate             DateTime     @db.Date
  /// Local start time of the agenda block; null = flexible (no time block).
  startTimeMinutes      Int?
  durationMinutes       Int?
  /// IANA timezone in which the rule is expanded.
  timezone              String       @db.VarChar(64)
  /// Last possible occurrence (derived from UNTIL/COUNT); null = no end. Prunes range queries.
  untilDate             DateTime?    @db.Date
  reminderOffsetMinutes Int?
  /// The series stopped generating occurrences (history is kept).
  endedAt               DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area    Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal    Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  habit   Habit?       @relation(fields: [habitId], references: [id], onDelete: SetNull)
  column  BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([userId, endedAt, startDate])
  @@map("recurring_tasks")
}

model ChecklistItem {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  taskId      String    @db.Char(36)
  title       String    @db.VarChar(255)
  position    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId, position])
  @@map("checklist_items")
}

model Tag {
  id         String   @id @default(uuid(7)) @db.Char(36)
  userId     String   @db.Char(36)
  name       String   @db.VarChar(40)
  colorToken String?  @db.VarChar(32)
  createdAt  DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TaskTag {
  taskId    String   @db.Char(36)
  tagId     String   @db.Char(36)
  userId    String   @db.Char(36)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([userId, tagId])
  @@map("task_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. AGENDA, DAILY EXECUTION, CAPTURE AND NOTES
// ─────────────────────────────────────────────────────────────────────────────

/// Fixed-time commitment or reserved time block. A recurring event is one row with an RRULE.
model Event {
  id              String    @id @default(uuid(7)) @db.Char(36)
  userId          String    @db.Char(36)
  kind            EventKind @default(APPOINTMENT)
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  location        String?   @db.VarChar(255)
  areaId          String?   @db.Char(36)
  goalId          String?   @db.Char(36)
  projectId       String?   @db.Char(36)
  habitId         String?   @db.Char(36)
  /// A planned study session points at its track.
  studyTrackId    String?   @db.Char(36)
  /// First occurrence (UTC). For allDay events: the date at 00:00 UTC, treated as a floating date.
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean   @default(false)
  /// IANA timezone in which the RRULE is expanded (keeps 19:00 at 19:00 across DST changes).
  timezone        String    @db.VarChar(64)
  /// RFC 5545 RRULE without DTSTART; null = single event.
  rrule           String?   @db.VarChar(500)
  /// Start of the last possible occurrence (derived from UNTIL/COUNT); null = no end.
  recurrenceUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  area          Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal          Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  habit         Habit?            @relation(fields: [habitId], references: [id], onDelete: SetNull)
  studyTrack    StudyTrack?       @relation(fields: [studyTrackId], references: [id], onDelete: SetNull)
  occurrences   EventOccurrence[]
  timeEntries   TimeEntry[]
  reminders     Reminder[]
  inboxItems    InboxItem[]
  notifications Notification[]

  @@index([userId, startsAt])
  @@index([userId, recurrenceUntil])
  @@index([userId, areaId, startsAt])
  @@map("events")
}

/// Persisted only when something happened to one occurrence: attended, missed, cancelled or
/// moved. Used for single events too (originalStartAt = Event.startsAt), so "compromissos
/// cumpridos" is one query.
model EventOccurrence {
  id              String                @id @default(uuid(7)) @db.Char(36)
  userId          String                @db.Char(36)
  eventId         String                @db.Char(36)
  /// Start computed from the rule for this occurrence (RFC 5545 RECURRENCE-ID).
  originalStartAt DateTime
  status          EventOccurrenceStatus @default(SCHEDULED)
  /// Overrides when this occurrence was moved; null = as computed from the series.
  startsAt        DateTime?
  endsAt          DateTime?
  note            String?               @db.VarChar(500)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStartAt])
  @@index([userId, originalStartAt])
  @@index([userId, startsAt])
  @@map("event_occurrences")
}

/// "Remind me N minutes before". Exactly one of taskId / eventId / habitId is set
/// (CHECK constraint added in the migration). Recurring tasks copy
/// RecurringTask.reminderOffsetMinutes into a Reminder on each materialised occurrence.
model Reminder {
  id            String   @id @default(uuid(7)) @db.Char(36)
  userId        String   @db.Char(36)
  taskId        String?  @db.Char(36)
  eventId       String?  @db.Char(36)
  habitId       String?  @db.Char(36)
  /// Minutes before the reference time (event start, task time block or due date, habit suggested time).
  offsetMinutes Int      @default(0)
  createdAt     DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}

/// "Foco do dia": at most three per day, enforced by the unique slot (1–3).
model DailyFocusItem {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  date        DateTime  @db.Date
  /// 1, 2 or 3 (CHECK constraint added in the migration).
  slot        Int
  /// The priority is either an existing task…
  taskId      String?   @db.Char(36)
  /// …or a free-text intention.
  title       String?   @db.VarChar(255)
  /// Only for free-text priorities; a task's completion comes from the task.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, date, slot])
  @@unique([userId, date, taskId])
  @@map("daily_focus_items")
}

model DailyReflection {
  id              String   @id @default(uuid(7)) @db.Char(36)
  userId          String   @db.Char(36)
  date            DateTime @db.Date
  /// O que consegui fazer?
  accomplished    String?  @db.Text
  /// O que ficou pendente?
  pending         String?  @db.Text
  /// O que aprendi?
  learned         String?  @db.Text
  /// O que posso melhorar amanhã?
  improveTomorrow String?  @db.Text
  /// Como foi meu dia?
  daySummary      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_reflections")
}

/// Quick Capture inbox. Capture is one text field; classification happens later. The item it
/// became is recorded with explicit FKs (no polymorphic pointer was needed: the brief lists
/// exactly six destinations).
model InboxItem {
  id                     String      @id @default(uuid(7)) @db.Char(36)
  userId                 String      @db.Char(36)
  content                String      @db.Text
  /// What the user said it is at capture time, if anything.
  kind                   CaptureKind @default(UNSORTED)
  status                 InboxStatus @default(PENDING)
  convertedTaskId        String?     @db.Char(36)
  convertedEventId       String?     @db.Char(36)
  convertedTransactionId String?     @db.Char(36)
  convertedNoteId        String?     @db.Char(36)
  convertedGoalId        String?     @db.Char(36)
  /// An idea promoted to a Project (status IDEA).
  convertedProjectId     String?     @db.Char(36)
  processedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  convertedTask        Task?        @relation(fields: [convertedTaskId], references: [id], onDelete: SetNull)
  convertedEvent       Event?       @relation(fields: [convertedEventId], references: [id], onDelete: SetNull)
  convertedTransaction Transaction? @relation(fields: [convertedTransactionId], references: [id], onDelete: SetNull)
  convertedNote        Note?        @relation(fields: [convertedNoteId], references: [id], onDelete: SetNull)
  convertedGoal        Goal?        @relation(fields: [convertedGoalId], references: [id], onDelete: SetNull)
  convertedProject     Project?     @relation(fields: [convertedProjectId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@map("inbox_items")
}

/// One notes table for every module. Context is given by explicit optional FKs; a note that
/// belongs to a module but to no specific item (e.g. English notes) uses `module`.
model Note {
  id           String     @id @default(uuid(7)) @db.Char(36)
  userId       String     @db.Char(36)
  title        String?    @db.VarChar(200)
  /// Markdown.
  body         String     @db.MediumText
  module       ModuleKey?
  areaId       String?    @db.Char(36)
  goalId       String?    @db.Char(36)
  projectId    String?    @db.Char(36)
  studyTrackId String?    @db.Char(36)
  lessonId     String?    @db.Char(36)
  bookId       String?    @db.Char(36)
  pinnedAt     DateTime?
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "Tagged with" contexts survive the deletion of the item…
  area       Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // …"owned by" contexts do not.
  studyTrack StudyTrack? @relation(fields: [studyTrackId], references: [id], onDelete: Cascade)
  lesson     Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  book       Book?       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  inboxItems InboxItem[]

  @@index([userId, archivedAt, updatedAt])
  @@index([userId, module, updatedAt])
  @@index([userId, studyTrackId])
  @@index([userId, bookId])
  @@index([userId, projectId])
  @@map("notes")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. HABITS
// ─────────────────────────────────────────────────────────────────────────────

model Habit {
  id          String          @id @default(uuid(7)) @db.Char(36)
  userId      String          @db.Char(36)
  areaId      String?         @db.Char(36)
  goalId      String?         @db.Char(36)
  name        String          @db.VarChar(120)
  description String?         @db.Text
  /// "Observações".
  notes       String?         @db.Text
  targetKind  HabitTargetKind @default(CHECK)
  /// Unit label for QUANTITY habits (e.g. "páginas").
  unit        String?         @db.VarChar(24)
  startDate   DateTime        @db.Date
  position    Float           @default(0)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  area           Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  schedules      HabitSchedule[]
  checkIns       HabitCheckIn[]
  pauses         HabitPause[]
  tasks          Task[]
  recurringTasks RecurringTask[]
  events         Event[]
  timeEntries    TimeEntry[]
  reminders      Reminder[]
  notifications  Notification[]

  @@index([userId, archivedAt, position])
  @@index([userId, goalId])
  @@map("habits")
}

/// Versioned schedule. Changing frequency closes the current row (effectiveTo) and opens a new
/// one, so past consistency is always judged by the rule that was valid on that day.
model HabitSchedule {
  id                   String            @id @default(uuid(7)) @db.Char(36)
  userId               String            @db.Char(36)
  habitId              String            @db.Char(36)
  effectiveFrom        DateTime          @db.Date
  /// Null = current schedule.
  effectiveTo          DateTime?         @db.Date
  kind                 HabitScheduleKind @default(FIXED_DAYS)
  /// FIXED_DAYS: RFC 5545 RRULE (e.g. "FREQ=DAILY", "FREQ=WEEKLY;BYDAY=MO,WE,FR").
  rrule                String?           @db.VarChar(500)
  /// FLEXIBLE: how many times per period.
  timesPerPeriod       Int?
  period               TargetPeriod?
  /// Per-occurrence target: minutes (DURATION) or quantity (QUANTITY).
  targetValue          Int?
  /// "Horário sugerido": minutes from midnight, local time.
  suggestedTimeMinutes Int?
  createdAt            DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@map("habit_schedules")
}

/// A persisted habit occurrence. Only DONE and EXCUSED exist: missing a day creates nothing.
model HabitCheckIn {
  id        String             @id @default(uuid(7)) @db.Char(36)
  userId    String             @db.Char(36)
  habitId   String             @db.Char(36)
  date      DateTime           @db.Date
  status    HabitCheckInStatus @default(DONE)
  /// Minutes or quantity achieved, for DURATION / QUANTITY habits.
  value     Int?
  note      String?            @db.VarChar(500)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_check_ins")
}

/// Pause period. Days inside a pause are not expected and never count as missed.
model HabitPause {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  habitId   String    @db.Char(36)
  startDate DateTime  @db.Date
  /// Null = paused until resumed.
  endDate   DateTime? @db.Date
  reason    String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId, habitId, startDate])
  @@map("habit_pauses")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. FINANCE
// ─────────────────────────────────────────────────────────────────────────────

/// Balance is never stored: openingBalanceCents + inflows (toAccountId) − outflows (fromAccountId).
model Account {
  id                  String      @id @default(uuid(7)) @db.Char(36)
  userId              String      @db.Char(36)
  name                String      @db.VarChar(80)
  type                AccountType @default(CHECKING)
  /// true = reserved money (reserva, viagem, notebook…): excluded from "disponível para gastos".
  isReserved          Boolean     @default(false)
  currency            String      @default("BRL") @db.Char(3)
  /// "Saldo inicial" on openingDate.
  openingBalanceCents Int         @default(0)
  openingDate         DateTime    @db.Date
  colorToken          String?     @db.VarChar(32)
  icon                String?     @db.VarChar(48)
  position            Float       @default(0)
  archivedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The goal funded by this account, if any.
  goal                   Goal?
  outgoingTransactions   Transaction[]         @relation("TransactionFrom")
  incomingTransactions   Transaction[]         @relation("TransactionTo")
  plannedContributions   PlannedContribution[] @relation("PlannedContributionTo")
  plannedContributionsOf PlannedContribution[] @relation("PlannedContributionFrom")

  @@unique([userId, name])
  @@index([userId, archivedAt, position])
  @@map("accounts")
}

model FinanceCategory {
  id         String              @id @default(uuid(7)) @db.Char(36)
  userId     String              @db.Char(36)
  name       String              @db.VarChar(60)
  kind       FinanceCategoryKind
  colorToken String?             @db.VarChar(32)
  icon       String?             @db.VarChar(48)
  position   Float               @default(0)
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, kind, name])
  @@map("finance_categories")
}

/// One row per movement. amountCents is always positive; direction comes from the accounts:
///   INCOME                → toAccountId only
///   EXPENSE               → fromAccountId only
///   TRANSFER              → from and to
///   RESERVE_CONTRIBUTION  → from (available) and to (reserved)
///   RESERVE_WITHDRAWAL    → from (reserved) and to (available)
/// Only INCOME and EXPENSE ever enter income/expense totals. (CHECK constraints in the migration.)
model Transaction {
  id                    String          @id @default(uuid(7)) @db.Char(36)
  userId                String          @db.Char(36)
  type                  TransactionType
  amountCents           Int
  currency              String          @default("BRL") @db.Char(3)
  /// Calendar day of the movement.
  date                  DateTime        @db.Date
  description           String          @db.VarChar(255)
  notes                 String?         @db.Text
  /// Required for INCOME/EXPENSE (service rule); null for transfers.
  categoryId            String?         @db.Char(36)
  fromAccountId         String?         @db.Char(36)
  toAccountId           String?         @db.Char(36)
  /// Set when this movement fulfils a planned contribution…
  plannedContributionId String?         @db.Char(36)
  /// …for this planned date (the exception row of the contribution's RRULE).
  plannedDate           DateTime?       @db.Date
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fromAccount         Account?             @relation("TransactionFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount           Account?             @relation("TransactionTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  plannedContribution PlannedContribution? @relation(fields: [plannedContributionId], references: [id], onDelete: SetNull)
  inboxItems          InboxItem[]

  @@unique([plannedContributionId, plannedDate])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
  @@index([userId, fromAccountId, date])
  @@index([userId, toAccountId, date])
  @@map("transactions")
}

/// Monthly limit for one category. `month` is always the first day of the month.
model Budget {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  categoryId  String   @db.Char(36)
  month       DateTime @db.Date
  amountCents Int
  currency    String   @default("BRL") @db.Char(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

/// "Aportes planejados": a recurring intention to move money into a reserve account. It becomes
/// real only when a Transaction is created for one of its dates.
model PlannedContribution {
  id            String    @id @default(uuid(7)) @db.Char(36)
  userId        String    @db.Char(36)
  /// Destination (reserve) account; the goal is reached through Account.goal.
  accountId     String    @db.Char(36)
  /// Default source account.
  fromAccountId String?   @db.Char(36)
  amountCents   Int
  currency      String    @default("BRL") @db.Char(3)
  /// RFC 5545 RRULE (e.g. "FREQ=MONTHLY;BYMONTHDAY=5").
  rrule         String    @db.VarChar(500)
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date
  note          String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation("PlannedContributionTo", fields: [accountId], references: [id], onDelete: Cascade)
  fromAccount  Account?      @relation("PlannedContributionFrom", fields: [fromAccountId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, accountId])
  @@map("planned_contributions")
}

/// "Evolução patrimonial informada manualmente".
model NetWorthSnapshot {
  id               String   @id @default(uuid(7)) @db.Char(36)
  userId           String   @db.Char(36)
  date             DateTime @db.Date
  assetsCents      Int
  liabilitiesCents Int      @default(0)
  currency         String   @default("BRL") @db.Char(3)
  note             String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("net_worth_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. STUDY CENTER (also used by Dev Space courses and the English Center)
// ─────────────────────────────────────────────────────────────────────────────

/// A learning track. A course (Dev Space) is a track with kind = COURSE.
model StudyTrack {
  id          String           @id @default(uuid(7)) @db.Char(36)
  userId      String           @db.Char(36)
  areaId      String?          @db.Char(36)
  goalId      String?          @db.Char(36)
  kind        StudyTrackKind   @default(TRACK)
  title       String           @db.VarChar(200)
  /// "Objetivo" of the track.
  objective   String?          @db.Text
  description String?          @db.Text
  /// Courses: platform / institution and link.
  provider    String?          @db.VarChar(120)
  url         String?          @db.VarChar(2048)
  status      StudyTrackStatus @default(NOT_STARTED)
  position    Float            @default(0)
  startedOn   DateTime?        @db.Date
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  modules         StudyModule[]
  resources       Resource[]
  notes           Note[]
  timeEntries     TimeEntry[]
  events          Event[]
  roadmapNodes    RoadmapNode[]
  periodicTargets PeriodicTarget[]

  @@index([userId, kind, status])
  @@index([userId, archivedAt, position])
  @@map("study_tracks")
}

model StudyModule {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  trackId     String   @db.Char(36)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   StudyTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([userId, trackId, position])
  @@map("study_modules")
}

/// "Aula" / content item. Track progress = DONE lessons ÷ lessons.
model Lesson {
  id              String         @id @default(uuid(7)) @db.Char(36)
  userId          String         @db.Char(36)
  moduleId        String         @db.Char(36)
  title           String         @db.VarChar(200)
  description     String?        @db.Text
  status          LearningStatus @default(NOT_STARTED)
  estimateMinutes Int?
  position        Float          @default(0)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      StudyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]
  notes       Note[]
  timeEntries TimeEntry[]

  @@index([userId, moduleId, position])
  @@index([userId, status])
  @@map("lessons")
}

/// Materials, external links and documentation — shared by Study Center and Dev Space.
/// A resource with no parent is a free entry in the user's documentation library.
model Resource {
  id            String       @id @default(uuid(7)) @db.Char(36)
  userId        String       @db.Char(36)
  type          ResourceType @default(LINK)
  title         String       @db.VarChar(200)
  url           String?      @db.VarChar(2048)
  description   String?      @db.Text
  studyTrackId  String?      @db.Char(36)
  lessonId      String?      @db.Char(36)
  projectId     String?      @db.Char(36)
  roadmapNodeId String?      @db.Char(36)
  position      Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyTrack  StudyTrack?  @relation(fields: [studyTrackId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roadmapNode RoadmapNode? @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)

  @@index([userId, studyTrackId])
  @@index([userId, projectId])
  @@index([userId, type])
  @@map("resources")
}

/// A numeric target per week or month, measured from the logs: weekly study goals, English
/// weekly goals, activity goals (workouts per week), bible-reading goals. Versioned by
/// startsOn/endsOn so past periods keep the target that was valid then.
model PeriodicTarget {
  id            String         @id @default(uuid(7)) @db.Char(36)
  userId        String         @db.Char(36)
  title         String?        @db.VarChar(120)
  metric        TargetMetric
  period        TargetPeriod   @default(WEEK)
  /// Minutes, sessions, pages, chapters or items, depending on `metric`.
  targetValue   Int
  // Optional scope for TIME_MINUTES:
  timeEntryKind TimeEntryKind?
  areaId        String?        @db.Char(36)
  studyTrackId  String?        @db.Char(36)
  startsOn      DateTime       @db.Date
  /// Null = still in force.
  endsOn        DateTime?      @db.Date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area?       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  studyTrack StudyTrack? @relation(fields: [studyTrackId], references: [id], onDelete: Cascade)

  @@index([userId, metric, startsOn])
  @@map("periodic_targets")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. DEV SPACE (projects live in section 3; courses are StudyTracks)
// ─────────────────────────────────────────────────────────────────────────────

/// The user's vocabulary of technologies: used as project stack and on roadmap nodes.
model Technology {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects     ProjectTechnology[]
  roadmapNodes RoadmapNode[]
  challenges   Challenge[]

  @@unique([userId, name])
  @@map("technologies")
}

/// Project stack.
model ProjectTechnology {
  projectId    String @db.Char(36)
  technologyId String @db.Char(36)
  userId       String @db.Char(36)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([userId, technologyId])
  @@map("project_technologies")
}

model Roadmap {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  areaId      String?   @db.Char(36)
  goalId      String?   @db.Char(36)
  title       String    @db.VarChar(160)
  description String?   @db.Text
  position    Float     @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area  Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal  Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  nodes RoadmapNode[]

  @@index([userId, archivedAt, position])
  @@map("roadmaps")
}

/// Tree of topics ("Backend" → "Node.js", "Prisma"…), each with its own learning status.
model RoadmapNode {
  id           String         @id @default(uuid(7)) @db.Char(36)
  userId       String         @db.Char(36)
  roadmapId    String         @db.Char(36)
  parentId     String?        @db.Char(36)
  title        String         @db.VarChar(160)
  description  String?        @db.Text
  status       LearningStatus @default(NOT_STARTED)
  technologyId String?        @db.Char(36)
  /// The track or course where this topic is being studied (its time comes from there).
  studyTrackId String?        @db.Char(36)
  position     Float          @default(0)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap    Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  parent     RoadmapNode?  @relation("RoadmapNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   RoadmapNode[] @relation("RoadmapNodeTree")
  technology Technology?   @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  studyTrack StudyTrack?   @relation(fields: [studyTrackId], references: [id], onDelete: SetNull)
  resources  Resource[]

  @@index([userId, roadmapId, parentId, position])
  @@index([userId, status])
  @@map("roadmap_nodes")
}

/// "Desafios técnicos".
model Challenge {
  id           String               @id @default(uuid(7)) @db.Char(36)
  userId       String               @db.Char(36)
  technologyId String?              @db.Char(36)
  title        String               @db.VarChar(200)
  description  String?              @db.Text
  /// Where it comes from (platform, book, interview…).
  source       String?              @db.VarChar(120)
  url          String?              @db.VarChar(2048)
  solutionUrl  String?              @db.VarChar(2048)
  difficulty   ChallengeDifficulty?
  status       ChallengeStatus      @default(TODO)
  notes        String?              @db.Text
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("challenges")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. ENGLISH CENTER (practice sessions are TimeEntry rows with kind = ENGLISH)
// ─────────────────────────────────────────────────────────────────────────────

/// Words and phrases in one table. The srs* columns stay null until spaced repetition ships.
model VocabularyItem {
  id              String           @id @default(uuid(7)) @db.Char(36)
  userId          String           @db.Char(36)
  kind            VocabularyKind   @default(WORD)
  term            String           @db.VarChar(255)
  translation     String?          @db.VarChar(255)
  meaning         String?          @db.Text
  /// The user's own example sentence.
  example         String?          @db.Text
  notes           String?          @db.Text
  status          VocabularyStatus @default(NEW)
  srsDueOn        DateTime?        @db.Date
  srsIntervalDays Int?
  srsEase         Float?
  srsRepetitions  Int?
  srsLapses       Int?
  lastReviewedAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([userId, status])
  @@index([userId, srsDueOn])
  @@map("vocabulary_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. HEALTH & FITNESS (no body measurements by design)
// ─────────────────────────────────────────────────────────────────────────────

model Exercise {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  name        String    @db.VarChar(120)
  muscleGroup String?   @db.VarChar(60)
  notes       String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planExercises WorkoutPlanExercise[]
  sets          WorkoutSet[]

  @@unique([userId, name])
  @@map("exercises")
}

/// "Treino A / B / C".
model WorkoutPlan {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  name        String    @db.VarChar(80)
  description String?   @db.Text
  position    Float     @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutPlanExercise[]
  logs      WorkoutLog[]

  @@index([userId, archivedAt, position])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id                String   @id @default(uuid(7)) @db.Char(36)
  userId            String   @db.Char(36)
  planId            String   @db.Char(36)
  exerciseId        String   @db.Char(36)
  position          Float    @default(0)
  targetSets        Int?
  /// Free text so ranges are possible ("8-12").
  targetReps        String?  @db.VarChar(20)
  targetWeightGrams Int?
  restSeconds       Int?
  notes             String?  @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, planId, position])
  @@map("workout_plan_exercises")
}

/// One training day or one walk. Its duration lives in the linked TimeEntry.
model WorkoutLog {
  id             String      @id @default(uuid(7)) @db.Char(36)
  userId         String      @db.Char(36)
  type           WorkoutType @default(STRENGTH)
  planId         String?     @db.Char(36)
  date           DateTime    @db.Date
  /// The time ledger row for this workout (kind = WORKOUT), if time was recorded.
  timeEntryId    String?     @unique @db.Char(36)
  /// Walks / cardio.
  distanceMeters Int?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  timeEntry TimeEntry?   @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  sets      WorkoutSet[]

  @@index([userId, date])
  @@index([userId, type, date])
  @@map("workout_logs")
}

model WorkoutSet {
  id              String   @id @default(uuid(7)) @db.Char(36)
  userId          String   @db.Char(36)
  workoutLogId    String   @db.Char(36)
  exerciseId      String   @db.Char(36)
  /// Order inside the workout.
  position        Float    @default(0)
  reps            Int?
  /// Grams, to keep weights integer (22.5 kg = 22500).
  weightGrams     Int?
  durationSeconds Int?
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, workoutLogId, position])
  @@index([userId, exerciseId])
  @@map("workout_sets")
}

// ─────────────────────────────────────────────────────────────────────────────
// 11. SPIRITUAL LIFE (no scores, no streak storage)
// ─────────────────────────────────────────────────────────────────────────────

model Devotional {
  id             String   @id @default(uuid(7)) @db.Char(36)
  userId         String   @db.Char(36)
  date           DateTime @db.Date
  /// "Texto bíblico lido", as the user writes it (e.g. "João 3:1-21").
  passage        String?  @db.VarChar(255)
  /// "Versículo ou referência do dia".
  verseReference String?  @db.VarChar(120)
  verseText      String?  @db.Text
  /// O que aprendeu.
  learned        String?  @db.Text
  reflection     String?  @db.Text
  /// Aplicação prática.
  application    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingLogs BibleReadingLog[]

  @@unique([userId, date])
  @@map("devotionals")
}

/// Structured record of bible reading, so reading goals can count chapters.
model BibleReadingLog {
  id           String   @id @default(uuid(7)) @db.Char(36)
  userId       String   @db.Char(36)
  date         DateTime @db.Date
  /// Three-letter book code (e.g. "GEN", "JHN"), validated against the shared list of 66 books.
  bookCode     String   @db.Char(3)
  chapterFrom  Int
  chapterTo    Int
  /// When the reading was part of that day's devotional.
  devotionalId String?  @db.Char(36)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotional Devotional? @relation(fields: [devotionalId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, bookCode, chapterFrom])
  @@map("bible_reading_logs")
}

model PrayerRequest {
  id          String              @id @default(uuid(7)) @db.Char(36)
  userId      String              @db.Char(36)
  title       String              @db.VarChar(200)
  description String?             @db.Text
  status      PrayerRequestStatus @default(ACTIVE)
  requestedOn DateTime            @db.Date
  answeredOn  DateTime?           @db.Date
  answerNote  String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PrayerLog[]

  @@index([userId, status, requestedOn])
  @@map("prayer_requests")
}

/// "Registro de orações": a prayer on a day, optionally for one request.
model PrayerLog {
  id              String   @id @default(uuid(7)) @db.Char(36)
  userId          String   @db.Char(36)
  date            DateTime @db.Date
  prayerRequestId String?  @db.Char(36)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayerRequest PrayerRequest? @relation(fields: [prayerRequestId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("prayer_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. READING
// ─────────────────────────────────────────────────────────────────────────────

model Book {
  id          String     @id @default(uuid(7)) @db.Char(36)
  userId      String     @db.Char(36)
  /// E.g. a "read 12 books" goal.
  goalId      String?    @db.Char(36)
  title       String     @db.VarChar(255)
  author      String?    @db.VarChar(200)
  /// "Categoria" (free text: ficção, técnico, teologia…).
  genre       String?    @db.VarChar(80)
  coverUrl    String?    @db.VarChar(2048)
  status      BookStatus @default(WANT_TO_READ)
  totalPages  Int?
  /// Current position; written together with each ReadingLog.
  currentPage Int        @default(0)
  startedOn   DateTime?  @db.Date
  finishedOn  DateTime?  @db.Date
  /// Personal rating, 1–5.
  rating      Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  readingLogs ReadingLog[]
  quotes      BookQuote[]
  notes       Note[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@index([userId, finishedOn])
  @@map("books")
}

model ReadingLog {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  bookId      String   @db.Char(36)
  date        DateTime @db.Date
  startPage   Int?
  endPage     Int?
  pagesRead   Int
  /// The time ledger row for this reading session (kind = READING), if time was recorded.
  timeEntryId String?  @unique @db.Char(36)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, bookId, date])
  @@map("reading_logs")
}

/// Short quotes with a personal comment.
model BookQuote {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  bookId    String   @db.Char(36)
  text      String   @db.Text
  page      Int?
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@map("book_quotes")
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. WEEKLY / MONTHLY REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(uuid(7)) @db.Char(36)
  userId         String       @db.Char(36)
  type           ReviewType
  /// First and last calendar day of the reviewed week/month (user's week start applied).
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  status         ReviewStatus @default(DRAFT)
  /// Metrics frozen when the review is completed, so history never changes afterwards.
  metrics        Json?
  /// Version of the `metrics` shape (validated with a zod schema in packages/shared).
  metricsVersion Int          @default(1)
  /// Generated "resumo" of the period.
  summary        String?      @db.Text
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       ReviewAnswer[]
  notifications Notification[]

  @@unique([userId, type, periodStart])
  @@map("reviews")
}

/// One answer per question. Question keys live in packages/shared, so weekly and monthly
/// questions can evolve without a migration.
model ReviewAnswer {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  reviewId    String   @db.Char(36)
  /// e.g. "biggest_win", "next_priority_1".
  questionKey String   @db.VarChar(64)
  answer      String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, questionKey])
  @@index([userId])
  @@map("review_answers")
}

// ─────────────────────────────────────────────────────────────────────────────
// 14. NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

/// Notification centre. Rows are created ahead of time by the scheduler (idempotent through
/// dedupeKey) and become visible once deliveredAt is set.
model Notification {
  id           String           @id @default(uuid(7)) @db.Char(36)
  userId       String           @db.Char(36)
  type         NotificationType
  title        String           @db.VarChar(200)
  body         String?          @db.VarChar(500)
  // What it is about (explicit FKs; at most one is set).
  taskId       String?          @db.Char(36)
  eventId      String?          @db.Char(36)
  habitId      String?          @db.Char(36)
  goalId       String?          @db.Char(36)
  reviewId     String?          @db.Char(36)
  /// e.g. "event:<id>:<occurrenceStart>:<offset>" — makes the scheduler safe to re-run.
  dedupeKey    String           @db.VarChar(191)
  scheduledFor DateTime
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  habit  Habit?  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, deliveredAt, readAt])
  /// Delivery worker (cross-user): pending rows whose time has come.
  @@index([deliveredAt, scheduledFor])
  @@map("notifications")
}

/// Which notification types the user wants, per channel. A missing row means the default (on).
model NotificationPreference {
  userId    String           @db.Char(36)
  type      NotificationType
  inApp     Boolean          @default(true)
  push      Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// Web Push subscriptions (one per browser/device). Stored now, used when push ships.
model PushSubscription {
  id           String    @id @default(uuid(7)) @db.Char(36)
  userId       String    @db.Char(36)
  endpoint     String    @db.Text
  /// SHA-256 (hex) of the endpoint, because a TEXT column cannot be unique.
  endpointHash String    @unique @db.Char(64)
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("push_subscriptions")
}
