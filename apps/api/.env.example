# RITMO API — copie para .env e ajuste.
NODE_ENV=development
PORT=3333
# Banco do desenvolvimento (MariaDB do projeto, ver `npm run db:start` na raiz)
DATABASE_URL=mysql://ritmo:ritmo_dev@127.0.0.1:3310/ritmo
# Banco usado pelos testes de integração (é apagado e recriado a cada execução)
TEST_DATABASE_URL=mysql://ritmo:ritmo_dev@127.0.0.1:3310/ritmo_test
# Segredo do token de acesso (mínimo 32 caracteres). Gere um novo em produção.
JWT_SECRET=troque-este-segredo-em-producao-por-algo-longo-e-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Cookie do refresh token: true em produção (HTTPS)
COOKIE_SECURE=false
LOG_LEVEL=info
