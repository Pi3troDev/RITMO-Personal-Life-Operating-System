  in_progress
  done
}

enum ResourceType {
  link
  video
  article
  documentation
  book
  file
  other
}

enum NoteScope {
  general
  dev
  study
  english
  reading
  health
  spiritual
}

enum DevProjectStatus {
  idea
  planned
  active
  paused
  completed
}

enum ChallengeDifficulty {
  easy
  medium
  hard
}

enum ChallengeStatus {
  todo
  in_progress
  solved
  abandoned
}

enum EnglishSkill {
  listening
  reading
  speaking
  writing
}

enum VocabularyKind {
  word
  phrase
}

enum VocabularyStatus {
  new
  learning
  mastered
}

enum BookStatus {
  want_to_read
  reading
  finished
  paused
}

enum WorkoutType {
  strength
  walk
  cardio
  other
}

enum PrayerStatus {
  active
  answered
  archived
}

enum TargetScope {
  study
  dev
  english
  reading
  health
  spiritual
}

/// O que uma meta semanal conta. Cada valor corresponde a uma consulta determinística.
enum TargetMetric {
  time_minutes
  workout_sessions
  pages_read
  bible_chapters
  vocabulary_items
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. IDENTIDADE, SESSÕES E CONFIGURAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Char(36)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(120)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settings               UserSettings?
  sessions               Session[]
  modules                UserModule[]
  areas                  Area[]
  boards                 Board[]
  boardColumns           BoardColumn[]
  tasks                  Task[]
  projects               Project[]
  events                 Event[]
  eventExceptions        EventException[]
  dailyFocusItems        DailyFocusItem[]
  dailyReflections       DailyReflection[]
  inboxItems             InboxItem[]
  habits                 Habit[]
  habitCheckins          HabitCheckin[]
  goals                  Goal[]
  milestones             Milestone[]
  goalProgressEntries    GoalProgressEntry[]
  visionItems            VisionItem[]
  accounts               Account[]
  financeCategories      FinanceCategory[]
  transactions           Transaction[]
  budgets                Budget[]
  timeEntries            TimeEntry[]
  reviews                Review[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  studyTracks            StudyTrack[]
  studyModules           StudyModule[]
  lessons                Lesson[]
  resources              Resource[]
  devProjects            DevProject[]
  roadmapNodes           RoadmapNode[]
  challenges             Challenge[]
  notes                  Note[]
  vocabularyItems        VocabularyItem[]
  periodicTargets        PeriodicTarget[]
  books                  Book[]
  readingLogs            ReadingLog[]
  bookQuotes             BookQuote[]
  workoutPlans           WorkoutPlan[]
  workoutLogs            WorkoutLog[]
  devotionals            Devotional[]
  bibleReadings          BibleReading[]
  prayerRequests         PrayerRequest[]
  prayerLogs             PrayerLog[]

  @@map("users")
}

model UserSettings {
  userId               String   @id @db.Char(36)
  /// Fuso IANA. Define o "dia" do usuário.
  timezone             String   @default("America/Sao_Paulo") @db.VarChar(64)
  locale               String   @default("pt-BR") @db.VarChar(10)
  /// 0 = domingo, 1 = segunda.
  weekStartsOn         Int      @default(1)
  theme                Theme    @default(dark)
  currency             String   @default("BRL") @db.Char(3)
  /// Minutos de trabalho planejado que o usuário considera realistas em um dia.
  dailyCapacityMinutes Int      @default(360)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Uma linha por refresh token emitido. A rotação cria uma nova linha na mesma família.
model Session {
  id         String    @id @default(uuid(7)) @db.Char(36)
  userId     String    @db.Char(36)
  /// Comum a todos os tokens descendentes de um login; reuso de token revogado revoga a família.
  familyId   String    @db.Char(36)
  /// SHA-256 (hex) do refresh token. O token em si nunca é guardado.
  tokenHash  String    @unique @db.Char(64)
  userAgent  String?   @db.VarChar(255)
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  /// Revogação explícita (logout, troca de senha) ou por rotação.
  revokedAt  DateTime?
  /// Só preenchido quando o token foi revogado por ter sido trocado por um novo (rotação normal).
  rotatedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Liga/desliga de módulo por usuário. Ausência de linha = módulo ativo.
model UserModule {
  userId    String   @db.Char(36)
  module    String   @db.VarChar(32)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@map("user_modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. ÁREAS
// ─────────────────────────────────────────────────────────────────────────────

model Area {
  id         String    @id @default(uuid(7)) @db.Char(36)
  userId     String    @db.Char(36)
  name       String    @db.VarChar(60)
  /// Token de cor do design system (`--area-*`), nunca um hexadecimal.
  color      String    @db.VarChar(32)
  /// Nome do ícone Lucide em kebab-case.
  icon       String    @db.VarChar(48)
  position   Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  projects    Project[]
  events      Event[]
  habits      Habit[]
  goals       Goal[]
  timeEntries TimeEntry[]
  studyTracks StudyTrack[]
  devProjects DevProject[]

  @@unique([userId, name])
  @@index([userId, archivedAt, position])
  @@map("areas")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. QUADROS, TAREFAS E PROJETOS
// ─────────────────────────────────────────────────────────────────────────────

model Board {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  name      String   @db.VarChar(60)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns BoardColumn[]
  tasks   Task[]

  @@index([userId, isDefault])
  @@map("boards")
}

/// Cada coluna mapeia para uma categoria de status; o status da tarefa é o da coluna em que ela está.
model BoardColumn {
  id             String     @id @default(uuid(7)) @db.Char(36)
  userId         String     @db.Char(36)
  boardId        String     @db.Char(36)
  name           String     @db.VarChar(40)
  statusCategory TaskStatus
  position       Float      @default(0)
  createdAt      DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
  @@map("board_columns")
}

model Project {
  id          String        @id @default(uuid(7)) @db.Char(36)
  userId      String        @db.Char(36)
  areaId      String?       @db.Char(36)
  goalId      String?       @db.Char(36)
  name        String        @db.VarChar(100)
  description String?       @db.Text
  status      ProjectStatus @default(active)
  dueDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal        Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks       Task[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@index([userId, goalId])
  @@map("projects")
}

model Task {
  id              String       @id @default(uuid(7)) @db.Char(36)
  userId          String       @db.Char(36)
  boardId         String       @db.Char(36)
  columnId        String       @db.Char(36)
  areaId          String?      @db.Char(36)
  projectId       String?      @db.Char(36)
  goalId          String?      @db.Char(36)
  title           String       @db.VarChar(200)
  description     String?      @db.Text
  /// Cache do `statusCategory` da coluna atual (escrito só pelo service, junto com `columnId`).
  status          TaskStatus   @default(todo)
  priority        TaskPriority @default(none)
  /// Chave de ordenação dentro da coluna (crescente).
  position        Float        @default(0)
  dueDate         DateTime?    @db.Date
  /// Quando definido, a tarefa tem um bloco de tempo na agenda.
  scheduledStart  DateTime?
  estimateMinutes Int?
  spentMinutes    Int          @default(0)
  tags            Json
  /// [{ id, title, done }]
  checklist       Json
  /// RRULE (RFC 5545). Ao concluir uma tarefa recorrente, a próxima é criada.
  recurrence      String?      @db.VarChar(255)
  notes           String?      @db.Text
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  area        Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  focusItems  DailyFocusItem[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@index([userId, columnId, position])
  @@index([userId, dueDate])
  @@index([userId, scheduledStart])
  @@index([userId, projectId])
  @@index([userId, goalId])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. AGENDA
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id              String      @id @default(uuid(7)) @db.Char(36)
  userId          String      @db.Char(36)
  areaId          String?     @db.Char(36)
  goalId          String?     @db.Char(36)
  title           String      @db.VarChar(200)
  description     String?     @db.Text
  start           DateTime
  end             DateTime
  allDay          Boolean     @default(false)
  location        String?     @db.VarChar(200)
  /// RRULE (RFC 5545); as ocorrências são expandidas na leitura.
  recurrence      String?     @db.VarChar(255)
  reminderMinutes Int?
  status          EventStatus @default(scheduled)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  exceptions  EventException[]
  timeEntries TimeEntry[]

  @@index([userId, start])
  @@index([userId, recurrence])
  @@map("events")
}

/// Ocorrência de uma série que foi cancelada ou marcada como feita individualmente.
model EventException {
  id           String      @id @default(uuid(7)) @db.Char(36)
  userId       String      @db.Char(36)
  eventId      String      @db.Char(36)
  /// Dia (no fuso do usuário) da ocorrência original.
  originalDate DateTime    @db.Date
  status       EventStatus
  createdAt    DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalDate])
  @@index([userId, originalDate])
  @@map("event_exceptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. MEU DIA E CAPTURA
// ─────────────────────────────────────────────────────────────────────────────

model DailyFocusItem {
  id       String   @id @default(uuid(7)) @db.Char(36)
  userId   String   @db.Char(36)
  date     DateTime @db.Date
  taskId   String   @db.Char(36)
  position Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, date, taskId])
  @@index([userId, date, position])
  @@map("daily_focus_items")
}

model DailyReflection {
  id           String   @id @default(uuid(7)) @db.Char(36)
  userId       String   @db.Char(36)
  date         DateTime @db.Date
  accomplished String   @db.Text
  pending      String   @db.Text
  learned      String   @db.Text
  improve      String   @db.Text
  mood         Mood?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_reflections")
}

model InboxItem {
  id          String      @id @default(uuid(7)) @db.Char(36)
  userId      String      @db.Char(36)
  kind        CaptureKind
  text        String      @db.VarChar(500)
  status      InboxStatus @default(pending)
  processedAt DateTime?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("inbox_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. HÁBITOS
// ─────────────────────────────────────────────────────────────────────────────

model Habit {
  id            String          @id @default(uuid(7)) @db.Char(36)
  userId        String          @db.Char(36)
  areaId        String?         @db.Char(36)
  goalId        String?         @db.Char(36)
  name          String          @db.VarChar(80)
  /// Dias da semana agendados: 0 = domingo … 6 = sábado.
  weekdays      Json
  /// HH:mm
  suggestedTime String?         @db.Char(5)
  targetType    HabitTargetType @default(check)
  targetValue   Float?
  targetUnit    String?         @db.VarChar(20)
  notes         String?         @db.Text
  status        HabitStatus     @default(active)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal        Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  checkins    HabitCheckin[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@index([userId, goalId])
  @@map("habits")
}

/// Não existe status "falhou": um dia agendado sem linha é só "não registrado".
model HabitCheckin {
  id        String             @id @default(uuid(7)) @db.Char(36)
  userId    String             @db.Char(36)
  habitId   String             @db.Char(36)
  date      DateTime           @db.Date
  status    HabitCheckinStatus
  value     Float?
  note      String?            @db.VarChar(500)
  createdAt DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_checkins")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. OBJETIVOS
// ─────────────────────────────────────────────────────────────────────────────

model Goal {
  id              String           @id @default(uuid(7)) @db.Char(36)
  userId          String           @db.Char(36)
  areaId          String?          @db.Char(36)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  category        GoalCategory
  status          GoalStatus       @default(active)
  startDate       DateTime         @db.Date
  targetDate      DateTime?        @db.Date
  progressMode    GoalProgressMode @default(manual)
  /// Percentual informado pelo usuário quando `progressMode = manual`.
  manualProgress  Float            @default(0)
  metricKind      GoalMetricKind?
  metricTarget    Float?
  metricUnit      String?          @db.VarChar(20)
  /// Valor atual informado à mão (usado quando não há conta vinculada nem fonte automática).
  metricCurrent   Float            @default(0)
  /// Conta-reserva cujo saldo alimenta uma métrica de dinheiro. Uma conta por objetivo.
  linkedAccountId String?          @unique @db.Char(36)
  /// Última vez que algo vinculado se moveu (tarefa, check-in, marco, aporte).
  lastActivityAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  linkedAccount   Account?            @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  milestones      Milestone[]
  progressEntries GoalProgressEntry[]
  visionItems     VisionItem[]
  projects        Project[]
  tasks           Task[]
  events          Event[]
  habits          Habit[]
  timeEntries     TimeEntry[]
  studyTracks     StudyTrack[]
  devProjects     DevProject[]
  books           Book[]

  @@index([userId, status, targetDate])
  @@index([userId, category, status])
  @@map("goals")
}

model Milestone {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  goalId      String    @db.Char(36)
  title       String    @db.VarChar(200)
  dueDate     DateTime? @db.Date
  position    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, position])
  @@map("milestones")
}

/// Histórico de progresso: no máximo um ponto por objetivo por dia, para o gráfico de evolução.
model GoalProgressEntry {
  id       String   @id @default(uuid(7)) @db.Char(36)
  userId   String   @db.Char(36)
  goalId   String   @db.Char(36)
  date     DateTime @db.Date
  progress Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([userId, date])
  @@map("goal_progress_entries")
}

/// "Visão 2027": os principais resultados que o usuário quer para um ano.
model VisionItem {
  id          String       @id @default(uuid(7)) @db.Char(36)
  userId      String       @db.Char(36)
  goalId      String?      @db.Char(36)
  year        Int
  title       String       @db.VarChar(160)
  description String?      @db.Text
  category    GoalCategory
  achieved    Boolean      @default(false)
  position    Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, year, position])
  @@map("vision_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. FINANÇAS
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                  String      @id @default(uuid(7)) @db.Char(36)
  userId              String      @db.Char(36)
  name                String      @db.VarChar(60)
  kind                AccountKind
  /// Dinheiro reservado tem destino e não conta como disponível para gastar.
  isReserved          Boolean     @default(false)
  initialBalanceCents Int         @default(0)
  archivedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal     Goal?
  outgoing Transaction[] @relation("TransactionSource")
  incoming Transaction[] @relation("TransactionDestination")

  @@unique([userId, name])
  @@map("accounts")
}

model FinanceCategory {
  id         String              @id @default(uuid(7)) @db.Char(36)
  userId     String              @db.Char(36)
  name       String              @db.VarChar(60)
  kind       FinanceCategoryKind
  icon       String              @db.VarChar(48)
  archivedAt DateTime?
  createdAt  DateTime            @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, kind, name])
  @@map("finance_categories")
}

/// `transfer` move dinheiro entre contas do próprio usuário e nunca é receita nem despesa.
model Transaction {
  id          String          @id @default(uuid(7)) @db.Char(36)
  userId      String          @db.Char(36)
  accountId   String          @db.Char(36)
  toAccountId String?         @db.Char(36)
  categoryId  String?         @db.Char(36)
  type        TransactionType
  description String          @db.VarChar(120)
  /// Sempre positivo; o tipo dá a direção.
  amountCents Int
  date        DateTime        @db.Date
  note        String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account          @relation("TransactionSource", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount Account?         @relation("TransactionDestination", fields: [toAccountId], references: [id], onDelete: Cascade)
  category  FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(uuid(7)) @db.Char(36)
  userId     String   @db.Char(36)
  categoryId String   @db.Char(36)
  /// YYYY-MM
  month      String   @db.Char(7)
  limitCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. REGISTRO DE TEMPO
// ─────────────────────────────────────────────────────────────────────────────

/// O livro-razão único do tempo realmente dedicado. Toda "sessão" do produto é uma linha aqui.
model TimeEntry {
  id              String          @id @default(uuid(7)) @db.Char(36)
  userId          String          @db.Char(36)
  kind            TimeEntryKind   @default(other)
  source          TimeEntrySource @default(timer)
  timerState      TimerState      @default(stopped)
  title           String?         @db.VarChar(200)
  notes           String?         @db.Text
  startedAt       DateTime
  /// Nulo enquanto o cronômetro está rodando ou pausado.
  endedAt         DateTime?
  /// Definido enquanto `running`: decorrido = durationSeconds + (agora − lastResumedAt).
  lastResumedAt   DateTime?
  /// Tempo ativo (pausas excluídas). Autoritativo depois de `stopped`.
  durationSeconds Int             @default(0)
  /// Dia de `startedAt` no fuso do usuário.
  localDate       DateTime        @db.Date

  areaId       String?       @db.Char(36)
  goalId       String?       @db.Char(36)
  projectId    String?       @db.Char(36)
  taskId       String?       @db.Char(36)
  eventId      String?       @db.Char(36)
  habitId      String?       @db.Char(36)
  studyTrackId String?       @db.Char(36)
  lessonId     String?       @db.Char(36)
  bookId       String?       @db.Char(36)
  /// Só para kind = english.
  englishSkill EnglishSkill?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  habit      Habit?      @relation(fields: [habitId], references: [id], onDelete: SetNull)
  studyTrack StudyTrack? @relation(fields: [studyTrackId], references: [id], onDelete: SetNull)
  lesson     Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  book       Book?       @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([userId, studyTrackId, localDate])
  @@index([userId, localDate])
  @@index([userId, kind, localDate])
  @@index([userId, areaId, localDate])
  @@index([userId, goalId, localDate])
  @@index([userId, taskId])
  @@index([userId, timerState])
  @@map("time_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. REVISÕES E NOTIFICAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(uuid(7)) @db.Char(36)
  userId      String       @db.Char(36)
  type        ReviewType
  /// Primeiro dia do período (segunda-feira da semana ou dia 1 do mês).
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  status      ReviewStatus @default(draft)
  /// { wentWell, wentBadly, learned, improve, ... } — respostas livres.
  answers     Json
  /// Até três prioridades do próximo período.
  priorities  Json
  /// Métricas congeladas quando a revisão é concluída.
  metrics     Json?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart])
  @@index([userId, type, periodStart])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Char(36)
  userId    String           @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.VarChar(500)
  /// Rota do app para onde a notificação leva.
  link      String?          @db.VarChar(200)
  /// Evita gerar o mesmo lembrete duas vezes (ex.: `event:<id>:<início>`).
  dedupeKey String           @db.VarChar(160)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId         String   @id @db.Char(36)
  eventReminders Boolean  @default(true)
  taskDue        Boolean  @default(true)
  habitReminders Boolean  @default(true)
  reviews        Boolean  @default(true)
  goalDeadlines  Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Base para web push: o envio real fica fora da primeira versão.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  endpoint  String   @db.VarChar(500)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 11. ESTUDOS
// ─────────────────────────────────────────────────────────────────────────────

model StudyTrack {
  id                  String           @id @default(uuid(7)) @db.Char(36)
  userId              String           @db.Char(36)
  areaId              String?          @db.Char(36)
  goalId              String?          @db.Char(36)
  name                String           @db.VarChar(120)
  kind                StudyTrackKind   @default(track)
  status              StudyTrackStatus @default(not_started)
  description         String?          @db.Text
  provider            String?          @db.VarChar(80)
  url                 String?          @db.VarChar(500)
  weeklyTargetMinutes Int?
  startedAt           DateTime?        @db.Date
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal        Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  modules     StudyModule[]
  lessons     Lesson[]
  resources   Resource[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@map("study_tracks")
}

model StudyModule {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  trackId   String   @db.Char(36)
  name      String   @db.VarChar(120)
  position  Float    @default(0)
  createdAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   StudyTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([trackId, position])
  @@map("study_modules")
}

model Lesson {
  id              String         @id @default(uuid(7)) @db.Char(36)
  userId          String         @db.Char(36)
  trackId         String         @db.Char(36)
  moduleId        String?        @db.Char(36)
  title           String         @db.VarChar(200)
  status          LearningStatus @default(not_started)
  durationMinutes Int?
  notes           String?        @db.Text
  position        Float          @default(0)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track       StudyTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  module      StudyModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([trackId, position])
  @@map("lessons")
}

model Resource {
  id        String       @id @default(uuid(7)) @db.Char(36)
  userId    String       @db.Char(36)
  trackId   String?      @db.Char(36)
  title     String       @db.VarChar(200)
  type      ResourceType @default(link)
  url       String?      @db.VarChar(500)
  notes     String?      @db.Text
  createdAt DateTime     @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  track StudyTrack? @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, trackId])
  @@map("resources")
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. DEV SPACE E ANOTAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model DevProject {
  id          String           @id @default(uuid(7)) @db.Char(36)
  userId      String           @db.Char(36)
  areaId      String?          @db.Char(36)
  goalId      String?          @db.Char(36)
  name        String           @db.VarChar(120)
  description String?          @db.Text
  status      DevProjectStatus @default(idea)
  repoUrl     String?          @db.VarChar(500)
  demoUrl     String?          @db.VarChar(500)
  stack       Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area    Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal    Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  roadmap RoadmapNode[]

  @@index([userId, status])
  @@map("dev_projects")
}

model RoadmapNode {
  id           String         @id @default(uuid(7)) @db.Char(36)
  userId       String         @db.Char(36)
  devProjectId String         @db.Char(36)
  parentId     String?        @db.Char(36)
  title        String         @db.VarChar(200)
  description  String?        @db.Text
  status       LearningStatus @default(not_started)
  position     Float          @default(0)
  createdAt    DateTime       @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  devProject DevProject    @relation(fields: [devProjectId], references: [id], onDelete: Cascade)
  parent     RoadmapNode?  @relation("RoadmapTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   RoadmapNode[] @relation("RoadmapTree")

  @@index([devProjectId, position])
  @@map("roadmap_nodes")
}

model Challenge {
  id         String              @id @default(uuid(7)) @db.Char(36)
  userId     String              @db.Char(36)
  title      String              @db.VarChar(200)
  platform   String?             @db.VarChar(60)
  url        String?             @db.VarChar(500)
  difficulty ChallengeDifficulty @default(medium)
  status     ChallengeStatus     @default(todo)
  notes      String?             @db.Text
  solvedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("challenges")
}

/// Anotação livre por módulo: ideias de dev, reflexões espirituais, anotações de leitura…
model Note {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  scope     NoteScope @default(general)
  title     String    @db.VarChar(200)
  body      String    @db.Text
  tags      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, createdAt])
  @@map("notes")
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. INGLÊS, METAS SEMANAIS E LEITURA
// ─────────────────────────────────────────────────────────────────────────────

model VocabularyItem {
  id             String           @id @default(uuid(7)) @db.Char(36)
  userId         String           @db.Char(36)
  kind           VocabularyKind   @default(word)
  term           String           @db.VarChar(200)
  meaning        String           @db.VarChar(500)
  example        String?          @db.VarChar(500)
  status         VocabularyStatus @default(new)
  tags           Json
  reviewCount    Int              @default(0)
  lastReviewedAt DateTime?
  /// Reservado para a revisão espaçada, fora da primeira versão.
  nextReviewAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("vocabulary_items")
}

/// Meta semanal por módulo (ex.: 5 h de estudo, 30 páginas, 3 treinos).
model PeriodicTarget {
  id          String       @id @default(uuid(7)) @db.Char(36)
  userId      String       @db.Char(36)
  scope       TargetScope
  metric      TargetMetric
  targetValue Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@map("periodic_targets")
}

model Book {
  id          String     @id @default(uuid(7)) @db.Char(36)
  userId      String     @db.Char(36)
  goalId      String?    @db.Char(36)
  title       String     @db.VarChar(200)
  author      String?    @db.VarChar(120)
  totalPages  Int?
  currentPage Int        @default(0)
  status      BookStatus @default(want_to_read)
  coverUrl    String?    @db.VarChar(500)
  rating      Int?
  startedAt   DateTime?  @db.Date
  finishedAt  DateTime?  @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs        ReadingLog[]
  quotes      BookQuote[]
  timeEntries TimeEntry[]

  @@index([userId, status])
  @@map("books")
}

model ReadingLog {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  bookId      String   @db.Char(36)
  date        DateTime @db.Date
  pagesRead   Int
  minutes     Int?
  note        String?  @db.VarChar(2000)
  /// Registro de tempo gerado quando a sessão informa minutos (mantido em sincronia pelo service).
  timeEntryId String?  @unique @db.Char(36)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([bookId, date])
  @@map("reading_logs")
}

model BookQuote {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @db.Char(36)
  bookId    String   @db.Char(36)
  text      String   @db.Text
  page      Int?
  note      String?  @db.VarChar(2000)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
  @@map("book_quotes")
}

// ─────────────────────────────────────────────────────────────────────────────
// 14. SAÚDE
// ─────────────────────────────────────────────────────────────────────────────

/// Divisão de treino (A/B/C…): dias da semana e lista de exercícios.
model WorkoutPlan {
  id          String    @id @default(uuid(7)) @db.Char(36)
  userId      String    @db.Char(36)
  name        String    @db.VarChar(80)
  description String?   @db.Text
  weekdays    Json
  /// [{ name, sets, reps, restSeconds, notes }]
  exercises   Json
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs WorkoutLog[]

  @@index([userId, archivedAt])
  @@map("workout_plans")
}

model WorkoutLog {
  id              String      @id @default(uuid(7)) @db.Char(36)
  userId          String      @db.Char(36)
  planId          String?     @db.Char(36)
  date            DateTime    @db.Date
  type            WorkoutType @default(strength)
  title           String      @db.VarChar(120)
  durationMinutes Int?
  distanceKm      Float?
  effort          Int?
  notes           String?     @db.Text
  /// [{ exercise, reps, weightKg }]
  sets            Json
  timeEntryId     String?     @unique @db.Char(36)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("workout_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 15. ESPIRITUALIDADE
// ─────────────────────────────────────────────────────────────────────────────

model Devotional {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  date        DateTime @db.Date
  title       String?  @db.VarChar(200)
  passage     String?  @db.VarChar(200)
  reflection  String   @db.Text
  application String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("devotionals")
}

model BibleReading {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  date        DateTime @db.Date
  book        String   @db.VarChar(60)
  chapterFrom Int
  chapterTo   Int
  notes       String?  @db.VarChar(2000)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("bible_readings")
}

model PrayerRequest {
  id          String       @id @default(uuid(7)) @db.Char(36)
  userId      String       @db.Char(36)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      PrayerStatus @default(active)
  answeredAt  DateTime?
  answerNote  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PrayerLog[]

  @@index([userId, status])
  @@map("prayer_requests")
}

model PrayerLog {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @db.Char(36)
  requestId   String?  @db.Char(36)
  date        DateTime @db.Date
  minutes     Int?
  notes       String?  @db.VarChar(2000)
  timeEntryId String?  @unique @db.Char(36)
  createdAt   DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  request PrayerRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("prayer_logs")
}
