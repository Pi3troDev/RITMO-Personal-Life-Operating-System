// RITMO — Personal Life Operating System · schema do banco (Prisma 7 + MariaDB).
//
// Convenções (detalhes em docs/DATABASE.md):
// - Todo registro do usuário carrega `userId` com ON DELETE CASCADE a partir de `users`.
// - Entre tabelas do usuário só se usa CASCADE ou SET NULL (nunca RESTRICT); a proteção contra
//   exclusões perigosas (coluna com tarefas, conta com movimentações) é feita nos services.
// - IDs são UUID v7 em CHAR(36). Dinheiro em centavos inteiros (`*Cents`).
// - Instantes em UTC (`DateTime`); dias do calendário em `@db.Date` (interpretados no fuso do usuário).
// - Os valores dos enums são os mesmos do contrato em packages/shared, então não há camada de
//   tradução entre o banco e a API.
// - Tabelas em snake_case minúsculo para se comportar igual no Windows e no Linux.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Theme {
  dark
  light
  system
}

enum TaskStatus {
  backlog
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  none
  low
  medium
  high
  urgent
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum EventStatus {
  scheduled
  done
  cancelled
}

enum CaptureKind {
  task
  idea
  event
  expense
  note
  goal
}

enum InboxStatus {
  pending
  converted
  discarded
}

enum Mood {
  great
  good
  neutral
  hard
  very_hard
}

enum HabitTargetType {
  check
  duration
  quantity
}

enum HabitStatus {
  active
  paused
  archived
}

enum HabitCheckinStatus {
  done
  skipped
}

enum GoalCategory {
  financial
  professional
  academic
  intellectual
  health
  spiritual
  personal
  relationships
}

enum GoalStatus {
  active
  paused
  completed
  archived
}

enum GoalProgressMode {
  manual
  milestones
  metric
}

enum GoalMetricKind {
  money
  hours
  count
}

enum AccountKind {
  checking
  cash
  reserve
  investment
}

enum FinanceCategoryKind {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum TimeEntryKind {
  task
  study
  dev
  english
  workout
  reading
  spiritual
  other
}

enum TimeEntrySource {
  timer
  manual
}

enum TimerState {
  running
  paused
  stopped
}

enum ReviewType {
  weekly
  monthly
}

enum ReviewStatus {
  draft
  completed
}

enum NotificationType {
  event_reminder
  task_due
  habit_reminder
  weekly_review
  monthly_review
  goal_deadline
}

enum StudyTrackKind {
  track
  course
}

enum StudyTrackStatus {
  not_started
  in_progress
  paused
  completed
}

/// Compartilhado por aulas e nós de roadmap: não iniciado / estudando / concluído.
enum LearningStatus {
